# Your complete OpenDEX endpoint. Use the exact wl-dev or wl URL OpenDEX gives you.
VITE_API_BASE=https://YOUR-WORKSPACE.wl-dev.opendex.ws

# Keep this false with the servers included in this repository.
VITE_API_PROXY=false

# Optional public ECHO rankings service. Replace it if you run your own compatible service.
VITE_ECHO_API_BASE=https://echo.flashhub.net
